# Copy to .env.local and fill in. Never commit .env.local.

# PostHog (free plan). Leave blank to run with analytics switched off (events become no-ops).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Feature flag key for the layout experiment (docs/ab-test-plan.md)
VITE_POSTHOG_LAYOUT_FLAG=

# Front end -> API
VITE_API_URL=

# API
VSEARCH_MODEL=
VSEARCH_DATA_DIR=
VSEARCH_TORCH_THREADS=
VSEARCH_ALLOWED_ORIGINS=

# Hugging Face (only if the datasets or model ever need a token)
HF_TOKEN=
